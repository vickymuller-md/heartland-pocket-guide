---
interface Props {
  title: string;
  open?: boolean;
  id?: string;
}
const { title, open = false, id } = Astro.props;
---
<details
  open={open}
  id={id}
  class="rounded-lg border border-[color:var(--color-grid)] bg-white/60 p-4 shadow-sm"
>
  <summary class="flex min-h-11 items-center text-base font-semibold text-[color:var(--color-cool)]">
    {title}
  </summary>
  <div class="mt-3 space-y-3 text-sm leading-relaxed">
    <slot />
  </div>
</details>
