---
interface Props {
  label?: string;
}
const { label = 'Print this page' } = Astro.props;
---
<button
  type="button"
  onclick="window.print()"
  class="inline-flex min-h-11 items-center gap-2 rounded border border-[color:var(--color-grid)] bg-white px-4 py-2 text-sm font-medium hover:bg-[color:var(--color-terminal-deep)] print:hidden"
>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4" aria-hidden="true">
    <path d="M5 4a2 2 0 00-2 2v3a2 2 0 002 2h.5v1H5a3 3 0 01-3-3V6a3 3 0 013-3h10a3 3 0 013 3v3a3 3 0 01-3 3h-.5v-1H15a2 2 0 002-2V6a2 2 0 00-2-2H5z"/>
    <path d="M6 10h8v6a1 1 0 01-1 1H7a1 1 0 01-1-1v-6zm1 2h6v1H7v-1zm0 2h6v1H7v-1z"/>
  </svg>
  {label}
</button>
