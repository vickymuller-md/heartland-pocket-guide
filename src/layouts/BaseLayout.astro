---
import '../styles/global.css';
import { pwaInfo } from 'virtual:pwa-info';
import Nav from '../components/Nav.astro';
import DisclaimerFooter from '../components/DisclaimerFooter.astro';

interface Props {
  title: string;
  description?: string;
  pageId?: string;
}

const {
  title,
  description = 'Offline clinical reference for rural heart failure management — HEARTLAND Protocol v3.3.',
  pageId,
} = Astro.props;

const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
const fullTitle =
  title === 'Rural HF Pocket Guide' ? title : `${title} — Rural HF Pocket Guide`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://guide.heartlandprotocol.org').href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#0f2544" />
    <meta name="description" content={description} />
    <meta name="author" content="Vicky Muller Ferreira, MD" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/icons/icon-192x192.png" />
    {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
    <script src="/src/pwa.ts"></script>
    <title>{fullTitle}</title>

    {gaId && (
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
    )}
    {gaId && (
      <script is:inline define:vars={{ gaId }}>
        {`
          window.dataLayer = window.dataLayer || [];
          function gtag(){ dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', gaId, { anonymize_ip: true });
        `}
      </script>
    )}
  </head>
  <body class="bg-[color:var(--color-terminal)] text-[color:var(--color-cool)]">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-2 focus:top-2 focus:z-50 focus:bg-[color:var(--color-cool)] focus:text-white focus:px-3 focus:py-2 focus:rounded">
      Skip to content
    </a>
    <Nav pageId={pageId} />
    <main id="main" class="mx-auto max-w-4xl px-4 pb-16 pt-6 sm:px-6 lg:px-8">
      <slot />
    </main>
    <DisclaimerFooter />
  </body>
</html>
