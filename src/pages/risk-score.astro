---
import BaseLayout from '../layouts/BaseLayout.astro';
import PrintButton from '../components/PrintButton.astro';
import {
  RISK_VARIABLES,
  TIER_THRESHOLDS,
  CARE_PATHWAYS,
  COMPARISON_TABLE_DATA,
} from '../data/risk-score';

const tiers: Array<keyof typeof CARE_PATHWAYS> = ['low', 'moderate', 'high'];
const tierLabel: Record<keyof typeof CARE_PATHWAYS, string> = {
  low: 'Low (0–4)',
  moderate: 'Moderate (5–8)',
  high: 'High (≥9)',
};
const tierBorder: Record<keyof typeof CARE_PATHWAYS, string> = {
  low: 'border-[color:var(--color-success)]',
  moderate: 'border-[color:var(--color-warning)]',
  high: 'border-[color:var(--color-alert)]',
};
---

<BaseLayout
  title="HEARTLAND Risk Score"
  description="10-variable risk score for rural heart failure — variables, tier thresholds, care pathways."
  pageId="risk-score"
>
  <header class="mb-6 flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-[color:var(--color-alert-deep)]">Module 1.2</p>
      <h1 class="mt-1 text-2xl font-bold sm:text-3xl">HEARTLAND Risk Score</h1>
      <p class="mt-2 max-w-2xl text-sm text-[color:var(--color-cool)]/80">
        Ten variables, maximum 18 points. A pragmatic heuristic for rural/resource-limited
        settings — it incorporates distance to care and social support alongside clinical and
        laboratory data.
      </p>
    </div>
    <PrintButton />
  </header>

  <section aria-labelledby="variables" class="mb-8">
    <h2 id="variables" class="mb-3 text-lg font-semibold">10 variables (Table 1)</h2>
    <div class="overflow-x-auto rounded-lg border border-[color:var(--color-grid)] bg-white">
      <table class="w-full border-collapse text-sm">
        <thead class="bg-[color:var(--color-terminal-deep)] text-left">
          <tr>
            <th class="p-3 font-semibold">Variable</th>
            <th class="p-3 font-semibold">Category</th>
            <th class="p-3 font-semibold text-right">Points</th>
          </tr>
        </thead>
        <tbody>
          {RISK_VARIABLES.map((v) => (
            <tr class="border-t border-[color:var(--color-grid)] align-top">
              <td class="p-3">
                <div class="font-medium text-[color:var(--color-cool)]">{v.label}</div>
                <div class="text-xs text-[color:var(--color-cool)]/70">{v.description}</div>
              </td>
              <td class="p-3 text-xs uppercase tracking-wide text-[color:var(--color-cool)]/70">{v.category}</td>
              <td class="p-3 text-right font-mono text-sm font-semibold">+{v.points}</td>
            </tr>
          ))}
          <tr class="border-t-2 border-[color:var(--color-cool)]/40 bg-[color:var(--color-terminal-deep)]">
            <td class="p-3 text-right font-semibold" colspan="2">Maximum</td>
            <td class="p-3 text-right font-mono font-bold">18</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <section aria-labelledby="tiers" class="mb-8">
    <h2 id="tiers" class="mb-3 text-lg font-semibold">Care pathways by tier</h2>
    <div class="grid gap-3 sm:grid-cols-3">
      {tiers.map((t) => {
        const p = CARE_PATHWAYS[t];
        const th = TIER_THRESHOLDS[t];
        return (
          <article class:list={['rounded-lg border-2 bg-white p-4', tierBorder[t]]}>
            <h3 class="text-sm font-semibold uppercase tracking-wide">{tierLabel[t]}</h3>
            <p class="mt-1 text-xs font-mono text-[color:var(--color-cool)]/60">
              Score {th.min}–{th.max === 18 ? '18' : th.max}
            </p>
            <dl class="mt-3 space-y-2 text-xs">
              <div>
                <dt class="font-semibold">Follow-up</dt>
                <dd class="text-[color:var(--color-cool)]/80">{p.followUp}</dd>
              </div>
              <div>
                <dt class="font-semibold">Monitoring</dt>
                <dd class="text-[color:var(--color-cool)]/80">{p.monitoring}</dd>
              </div>
              <div>
                <dt class="font-semibold">Support</dt>
                <dd class="text-[color:var(--color-cool)]/80">{p.support}</dd>
              </div>
            </dl>
          </article>
        );
      })}
    </div>
  </section>

  <section aria-labelledby="comparison" class="mb-6">
    <h2 id="comparison" class="mb-3 text-lg font-semibold">HEARTLAND vs. existing scores (Table 6)</h2>
    <div class="overflow-x-auto rounded-lg border border-[color:var(--color-grid)] bg-white">
      <table class="w-full border-collapse text-xs sm:text-sm">
        <thead class="bg-[color:var(--color-terminal-deep)] text-left">
          <tr>
            <th class="p-3 font-semibold">Characteristic</th>
            <th class="p-3 font-semibold">MAGGIC</th>
            <th class="p-3 font-semibold">GWTG-HF</th>
            <th class="p-3 font-semibold">SHFM</th>
            <th class="p-3 font-semibold text-[color:var(--color-alert-deep)]">HEARTLAND</th>
          </tr>
        </thead>
        <tbody>
          {COMPARISON_TABLE_DATA.map((r) => (
            <tr class="border-t border-[color:var(--color-grid)] align-top">
              <td class="p-3 font-medium">{r.characteristic}</td>
              <td class="p-3">{r.maggic}</td>
              <td class="p-3">{r.gwtgHf}</td>
              <td class="p-3">{r.shfm}</td>
              <td class="p-3 font-semibold text-[color:var(--color-cool)]">{r.heartland}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <aside class="rounded-lg border border-[color:var(--color-warning)] bg-[#fff7ed] p-4 text-sm">
    <strong>Important disclaimer.</strong> This score is a pragmatic heuristic designed to
    supplement — not replace — validated prognostic instruments. It has not been statistically
    validated through derivation/validation cohorts with ROC analysis or calibration testing.
    Formal validation using registry data is a planned next step.
  </aside>
</BaseLayout>
